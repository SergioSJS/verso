{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Verso",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 17,
          "y": 17
        }
      }
    ]
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "net.daringfireball.markdown"
        ]
      },
      {
        "ext": [
          "json"
        ],
        "name": "JSON",
        "description": "JSON file",
        "mimeType": "application/json",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "public.json"
        ]
      },
      {
        "ext": [
          "yaml",
          "yml"
        ],
        "name": "YAML",
        "description": "YAML file",
        "mimeType": "application/yaml",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "public.yaml"
        ]
      },
      {
        "ext": [
          "toml"
        ],
        "name": "TOML",
        "description": "TOML file",
        "mimeType": "application/toml",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "io.toml"
        ]
      },
      {
        "ext": [
          "xml"
        ],
        "name": "XML",
        "description": "XML file",
        "mimeType": "application/xml",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "public.xml"
        ]
      },
      {
        "ext": [
          "csv"
        ],
        "name": "CSV",
        "description": "CSV file",
        "mimeType": "text/csv",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "public.comma-separated-values-text"
        ]
      }
    ]
  }
}
