{
  "identifier": "default",
  "description": "The app's own views — the main window, other windows of the same folder, and the notes popped out of them — and nothing else: the core's commands, window focus, and closing its own window once its tabs are saved. Listed by web view, not by window, so a web page shown inside a window (a child view labelled web-*) gets none of it. No fs plugin and no dialog permission: notes are reached only through verso-core, and the native folder picker runs on the host's side (pick_folder), so no path ever reaches the UI (ADR 0026 rule 4).",
  "webviews": [
    "main",
    "window-*",
    "note-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "allow-pick-folder",
    "allow-reopen-folder",
    "allow-open-initial",
    "allow-list-notes",
