    "allow-create-folder",
    "allow-delete-note",
    "allow-rename-note",
    "allow-resolve-attachment",
    "allow-list-files",
    "allow-list-folders",
    "allow-list-tags",
    "allow-read-file-text",
    "allow-list-entries",
    "allow-list-web-notes",
    "allow-graph",
    "allow-current-folder",
    "allow-app-info",
    "allow-open-window",
    "allow-popout-target",
    "allow-return-to-main",
    "allow-open-url",
    "allow-open-devtools",
    "allow-fetch-file",
    "allow-web-open",
    "allow-web-bounds",
