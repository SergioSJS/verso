{
  "identifier": "default",
  "description": "The app's own views — the main window and the notes popped out of it — and nothing else: the core's commands, the native folder picker (the entry edge, ADR 0026 rule 4) and window focus. Listed by web view, not by window, so a web page shown inside a window (a child view labelled web-*) gets none of it. No fs plugin: notes are reached only through verso-core.",
  "webviews": [
    "main",
    "note-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "allow-open-folder",
    "allow-list-notes",
    "allow-read-note",
    "allow-search",
    "allow-links",
    "allow-backlinks",
    "allow-write-note",
    "allow-create-note",
    "allow-create-file",
    "allow-create-folder",
    "allow-delete-note",
    "allow-rename-note",
    "allow-resolve-attachment",
    "allow-list-files",
    "allow-list-folders",
    "allow-list-tags",
    "allow-read-file-text",
    "allow-list-entries",
    "allow-list-web-notes",
    "allow-graph",
    "allow-initial-folder",
    "allow-current-folder",
    "allow-open-window",
    "allow-popout-target",
    "allow-return-to-main",
    "allow-open-url",
    "allow-web-open",
    "allow-web-bounds",
    "allow-web-visible",
    "allow-web-close",
    "allow-web-nav",
    "allow-web-url",
    "allow-read-text",
    "allow-write-text",
    "allow-rename-entry",
    "allow-delete-entry",
    "allow-reveal",
    "allow-reindex"
  ]
}
