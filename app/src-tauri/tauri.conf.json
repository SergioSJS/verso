{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verso",
  "identifier": "com.versomd.app",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Verso",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http: verso: http://verso.localhost; media-src 'self' blob: https: http: verso: http://verso.localhost; frame-src https: http: verso: http://verso.localhost; object-src 'none'; connect-src 'self' ipc: http://ipc.localhost https: http: verso: http://verso.localhost; worker-src 'self' blob:; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": { "signingIdentity": "-" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": { "../ui/dist-web/": "ui-web/" },
    "category": "Productivity",
    "shortDescription": "Notes in Markdown, in plain files you own",
    "linux": {
      "deb": { "section": "text", "depends": ["xdg-utils"], "recommends": ["pulseaudio-utils"] },
      "rpm": { "depends": ["xdg-utils"], "recommends": ["pulseaudio-utils"], "compression": { "type": "zstd", "level": 3 } },
      "appimage": { "bundleMediaFramework": false }
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
