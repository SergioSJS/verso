{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verso",
  "version": "0.0.0",
  "identifier": "dev.verso.app",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Verso",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: verso: http://verso.localhost; media-src verso: http://verso.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
