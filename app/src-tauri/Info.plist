<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist by Tauri when it bundles for macOS.
     "This app is a server" (ADR 0096 item 9): macOS 15 and later asks for the
     Local Network permission the first time the app announces itself or takes
     a connection on the network; these are the words it shows and the
     services the app announces or browses: `_verso-local._tcp`, announced
     while the pairing dialog is open, and `_verso._tcp`, browsed while
     Settings > Servers is open to list the UniVerso servers on the home
     network (ADR 0097). Without a service type here macOS 15 and later
     lets a browse find nothing, silently. -->
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Verso lets a phone on this network open the folders you choose, only while "Turn into a server" is on, and looks for Verso servers on this network while Settings > Servers is open.</string>
  <!-- Share audio (ADR 0116 item 17): the first time a share captures the
       sound of an app or of the Mac, macOS asks for "System Audio Recording"
       and shows this text. A person may read it in either language, so it
       says both. -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>Verso records the sound of the app or the Mac that you choose to share, only while Share audio is on, and sends it to the people at your table. Verso saves nothing. / O Verso grava o som do app ou do Mac que você escolher compartilhar, só enquanto o Compartilhar áudio estiver ligado, e o envia às pessoas da sua mesa. O Verso não guarda nada.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_verso-local._tcp</string>
    <string>_verso._tcp</string>
  </array>
  <!-- Markdown as a type the system knows (ADR 0114 item 2): since the
       version-27 systems Markdown has a system-declared type,
       net.daringfireball.markdown; an older system learns it from this
       import, so the document type the bundle declares
       (tauri.macos.conf.json, bundle.fileAssociations: md and markdown,
       role Editor, rank Alternate) names a type that exists. Verso is
       offered under "Open with" and never made the default by itself. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>net.daringfireball.markdown</string>
      <key>UTTypeDescription</key>
      <string>Markdown document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.utf8-plain-text</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>md</string>
          <string>markdown</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>text/markdown</string>
        </array>
      </dict>
    </dict>
    <!-- TOML (ADR 0114 item 31, amended 2026-10-31): macOS declares no
         type for it (the system's own declarations, CoreTypes.bundle, and
         Apple's list of system-declared types name JSON, YAML, XML and
         CSV, never TOML), so the document type the bundle declares for
         .toml names this import, after the format's own domain, toml.io.
         JSON (public.json), YAML (public.yaml), XML (public.xml) and CSV
         (public.comma-separated-values-text) are the system's and are not
         imported here. -->
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.toml</string>
      <key>UTTypeDescription</key>
      <string>TOML file</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.utf8-plain-text</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>toml</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/toml</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
