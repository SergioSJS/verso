      "--yellow": "#dbbc7f",
      "--green": "#a7c080",
      "--cyan": "#83c092",
      "--blue": "#7fbbb3",
      "--purple": "#d699b6"
    },
    "--heading-font": "system",
    "--book": "system",
    "font-size": 16,
    "tag-style": "outline",
    "heading-scale": "large",
    "heading-weight": "regular",
    "line-width": "narrow",
    "line-height": "snug",
    "blockquote-style": "bar",
    "hr-style": "line"
