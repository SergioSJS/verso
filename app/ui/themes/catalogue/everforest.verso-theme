      "--h2-color": "#e8670b",
      "--h3-color": "#ac8937",
      "--h4-color": "#84973e",
      "--h5-color": "#559b78",
      "--h6-color": "#b87b9d",
      "--red": "#f85552",
      "--orange": "#f57d26",
      "--yellow": "#dfa000",
      "--green": "#8da101",
      "--cyan": "#35a77c",
      "--blue": "#3a94c5",
      "--purple": "#df69ba"
    },
    "dark": {
      "--paper": "#2d353b",
      "--paper-2": "#343f44",
      "--hair": "#3d484d",
      "--ink": "#d3c6aa",
      "--ink-2": "#9da9a0",
      "--seal": "#a7c080",
      "--brass-ink": "#dbbc7f",
      "--code-paper": "#232a2e",
      "--code-ink": "#d3c6aa",
      "--h1-color": "#da6362",
      "--h2-color": "#d77f48",
      "--h3-color": "#bf983d",
      "--h4-color": "#899c40",
      "--h5-color": "#569d79",
      "--h6-color": "#b87b9d",
      "--red": "#e67e80",
