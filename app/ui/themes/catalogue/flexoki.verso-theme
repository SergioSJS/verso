{
  "verso-theme": 1,
  "name": "Flexoki",
  "mode": "both",
  "tokensVersion": 2,
  "inspiredBy": {
    "theme": "Flexoki",
    "author": "Steph Ango (kepano), stephango.com/flexoki",
    "repoUrl": "https://github.com/kepano/flexoki",
    "license": "MIT"
  },
  "values": {
    "light": {
      "--paper": "#fffcf0",
      "--paper-2": "#f2f0e5",
      "--hair": "#e6e4d9",
      "--ink": "#100f0f",
      "--ink-2": "#6f6e69",
      "--seal": "#205ea6",
      "--brass-ink": "#bc5215",
      "--code-paper": "#f2f0e5",
      "--code-ink": "#100f0f",
      "--h1-color": "#100f0f",
      "--h2-color": "#100f0f",
      "--h3-color": "#100f0f",
      "--h4-color": "#100f0f",
      "--h5-color": "#100f0f",
      "--h6-color": "#100f0f",
      "--red": "#af3029",
      "--orange": "#bc5215",
      "--yellow": "#ad8301",
      "--green": "#66800b",
      "--cyan": "#24837b",
      "--blue": "#205ea6",
      "--purple": "#5e409d",
      "--pink": "#a02f6f"
    },
    "dark": {
      "--paper": "#100f0f",
      "--paper-2": "#1c1b1a",
      "--hair": "#282726",
      "--ink": "#cecdc3",
      "--ink-2": "#878580",
      "--seal": "#4385be",
      "--brass-ink": "#da702c",
      "--code-paper": "#1c1b1a",
      "--code-ink": "#cecdc3",
      "--h1-color": "#cecdc3",
      "--h2-color": "#cecdc3",
      "--h3-color": "#cecdc3",
      "--h4-color": "#cecdc3",
      "--h5-color": "#cecdc3",
      "--h6-color": "#cecdc3",
      "--red": "#d14d41",
      "--orange": "#da702c",
      "--yellow": "#d0a215",
      "--green": "#879a39",
      "--cyan": "#3aa99f",
      "--blue": "#4385be",
      "--purple": "#8b7ec8",
      "--pink": "#ce5d97"
    },
    "--heading-font": "system",
    "--book": "system",
    "font-size": 16,
    "heading-scale": "large",
    "line-width": "narrow",
    "line-height": "snug",
    "blockquote-style": "bar",
    "hr-style": "line"
  }
}
