      "--code-paper": "#181c26",
      "--code-ink": "#cccac2",
      "--red": "#f28779",
      "--orange": "#ffa659",
      "--yellow": "#ffcd66",
      "--green": "#d5ff80",
      "--cyan": "#95e6cb",
      "--blue": "#73d0ff",
      "--purple": "#dfbfff"
