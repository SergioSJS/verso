{
  "verso-theme": 1,
  "name": "Gruvbox",
  "mode": "both",
  "tokensVersion": 2,
  "inspiredBy": {
    "theme": "Gruvbox",
    "author": "Pavel Pertsev (morhetz)",
    "repoUrl": "https://github.com/gruvbox-community/gruvbox",
    "license": "MIT"
  },
  "values": {
    "light": {
      "--paper": "#fbf1c7",
      "--paper-2": "#ebdbb2",
      "--hair": "#d5c4a1",
      "--ink": "#3c3836",
      "--ink-2": "#7c6f64",
      "--seal": "#076678",
      "--brass-ink": "#b57614",
      "--code-paper": "#f2e5bc",
      "--code-ink": "#3c3836",
      "--h1-color": "#cc241d",
      "--h2-color": "#b6811c",
      "--h3-color": "#8f8e19",
      "--h4-color": "#629764",
      "--h5-color": "#458588",
      "--h6-color": "#b16286",
      "--red": "#9d0006",
      "--orange": "#af3a03",
      "--yellow": "#b57614",
      "--green": "#79740e",
      "--cyan": "#427b58",
      "--blue": "#076678",
      "--purple": "#8f3f71"
    },
    "dark": {
      "--paper": "#282828",
      "--paper-2": "#3c3836",
      "--hair": "#504945",
      "--ink": "#ebdbb2",
      "--ink-2": "#a89984",
      "--seal": "#83a598",
      "--brass-ink": "#fabd2f",
      "--code-paper": "#1d2021",
      "--code-ink": "#ebdbb2",
      "--h1-color": "#dc271f",
      "--h2-color": "#d79921",
      "--h3-color": "#98971a",
      "--h4-color": "#689d6a",
      "--h5-color": "#458588",
      "--h6-color": "#b16286",
      "--red": "#fb4934",
      "--orange": "#fe8019",
      "--yellow": "#fabd2f",
      "--green": "#b8bb26",
      "--cyan": "#8ec07c",
      "--blue": "#83a598",
      "--purple": "#d3869b"
    },
    "--heading-font": "system",
    "--book": "system",
    "--mono": "mono",
    "font-size": 16,
    "table-style": "striped",
    "tag-style": "pill",
    "heading-scale": "large",
    "line-width": "narrow",
    "line-height": "snug",
    "blockquote-style": "bar",
    "link-style": "plain",
    "callout-style": "outlined",
    "hr-style": "line"
  }
}
