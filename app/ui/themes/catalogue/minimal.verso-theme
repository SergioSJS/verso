{
  "verso-theme": 1,
  "name": "Minimal",
  "mode": "both",
  "tokensVersion": 2,
  "inspiredBy": {
    "theme": "Minimal",
    "author": "Steph Ango (kepano)",
    "repoUrl": "https://github.com/kepano/obsidian-minimal",
    "license": "MIT"
  },
  "values": {
    "light": {
      "--paper": "#ffffff",
      "--paper-2": "#f5f5f5",
      "--hair": "#e6e6e6",
      "--ink": "#0f0f0f",
      "--ink-2": "#757575",
      "--seal": "#6a8695",
      "--brass-ink": "#0f0f0f",
      "--code-ink": "#0f0f0f",
      "--red": "#d04255",
      "--orange": "#d5763f",
      "--yellow": "#e5b567",
      "--green": "#a8c373",
      "--cyan": "#73bbb2",
      "--blue": "#6c99bb",
      "--purple": "#9e86c8",
      "--pink": "#b05279"
    },
    "dark": {
      "--paper": "#262626",
      "--paper-2": "#212121",
      "--hair": "#363636",
      "--ink": "#d1d1d1",
      "--ink-2": "#999999",
      "--seal": "#889eaa",
      "--brass-ink": "#d1d1d1",
      "--code-ink": "#d1d1d1",
      "--red": "#d04255",
      "--orange": "#d5763f",
      "--yellow": "#e5b567",
      "--green": "#a8c373",
      "--cyan": "#73bbb2",
      "--blue": "#6c99bb",
      "--purple": "#9e86c8",
      "--pink": "#b05279"
    },
    "surface-mode": "flat",
    "--heading-font": "system",
    "--book": "system",
    "font-size": 16,
    "table-style": "hairline",
    "tag-style": "minimal",
    "radius": "soft",
    "heading-scale": "compact",
    "line-width": "narrow",
    "line-height": "snug",
    "blockquote-style": "bar",
    "link-style": "plain",
    "paragraph-spacing": "loose",
    "callout-style": "outlined",
    "hr-style": "line"
  }
}
