      "--h1-color": "#222222",
      "--h2-color": "#222222",
      "--h3-color": "#2e80f2",
      "--h4-color": "#c78822",
      "--h5-color": "#e83e3e",
      "--h6-color": "#555e68",
      "--red": "#e4374b",
      "--orange": "#d96c00",
      "--yellow": "#bd8e37",
      "--green": "#0cb54f",
      "--cyan": "#2db7b5",
      "--blue": "#086ddd",
      "--purple": "#876be0",
      "--pink": "#c32b74"
    },
    "dark": {
      "--paper": "#1c2127",
      "--paper-2": "#181c20",
      "--hair": "#35393e",
      "--ink": "#dadada",
      "--ink-2": "#bec6cf",
      "--seal": "#79a9ec",
      "--brass-ink": "#dadada",
      "--h1-color": "#dadada",
      "--h2-color": "#dadada",
      "--h3-color": "#2e80f2",
      "--h4-color": "#e5b567",
      "--h5-color": "#e83e3e",
      "--h6-color": "#bec6cf",
      "--red": "#fb464c",
      "--orange": "#e9973f",
      "--yellow": "#e0de71",
      "--green": "#44cf6e",
      "--cyan": "#53dfdd",
      "--blue": "#027aff",
      "--purple": "#a882ff",
      "--pink": "#fa99cd"
    },
    "--heading-font": "system",
    "--book": "system",
    "--mono": "mono",
    "font-size": 16,
    "heading-style": "rule",
    "table-style": "hairline",
    "tag-style": "pill",
    "radius": "soft",
    "line-width": "narrow",
    "line-height": "snug",
    "checkbox-style": "round",
    "hr-style": "line"
  }
}
