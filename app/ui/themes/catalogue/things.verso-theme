{
  "verso-theme": 1,
  "name": "Things",
  "mode": "both",
  "tokensVersion": 2,
  "inspiredBy": {
    "theme": "Things",
    "author": "Colin Eckert",
    "repoUrl": "https://github.com/colineckert/obsidian-things",
    "license": "MIT"
  },
  "values": {
    "light": {
      "--paper": "#ffffff",
      "--paper-2": "#f6f7f8",
      "--hair": "#ebedf0",
      "--ink": "#222222",
      "--ink-2": "#555e68",
      "--seal": "#4c8ce6",
