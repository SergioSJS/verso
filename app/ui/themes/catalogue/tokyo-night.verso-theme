{
  "verso-theme": 1,
  "name": "Tokyo Night",
  "mode": "both",
  "tokensVersion": 2,
  "inspiredBy": {
    "theme": "Tokyo Night",
    "author": "enkia (Tokyo Night VS Code theme)",
    "repoUrl": "https://github.com/tokyo-night/tokyo-night-vscode-theme",
    "license": "MIT"
  },
  "values": {
    "light": {
      "--paper": "#e6e7ed",
      "--paper-2": "#d6d8df",
      "--hair": "#c1c2c7",
      "--ink": "#343b59",
      "--ink-2": "#707280",
      "--seal": "#2959aa",
      "--brass-ink": "#363c4d",
      "--code-paper": "#d6d8df",
      "--code-ink": "#65359d",
      "--h1-color": "#8c4351",
      "--h2-color": "#8f5e15",
      "--h3-color": "#33635c",
      "--h4-color": "#006c86",
      "--h5-color": "#2959aa",
      "--h6-color": "#7b43ba",
      "--red": "#8c4351",
      "--yellow": "#8f5e15",
      "--green": "#33635c",
      "--cyan": "#006c86",
      "--blue": "#2959aa",
      "--purple": "#7b43ba"
    },
    "dark": {
      "--paper": "#1a1b26",
      "--paper-2": "#16161e",
      "--hair": "#101014",
      "--ink": "#a9b1d6",
      "--ink-2": "#787c99",
      "--seal": "#6183bb",
      "--brass-ink": "#89ddff",
      "--code-paper": "#16161e",
      "--code-ink": "#bb9af7",
      "--h1-color": "#f7768e",
      "--h2-color": "#e0af68",
      "--h3-color": "#73daca",
      "--h4-color": "#7dcfff",
      "--h5-color": "#7aa2f7",
      "--h6-color": "#bb9af7",
      "--red": "#f7768e",
      "--yellow": "#e0af68",
      "--green": "#73daca",
      "--cyan": "#7dcfff",
      "--blue": "#7aa2f7",
      "--purple": "#bb9af7"
    },
    "--heading-font": "mono",
    "--book": "mono",
    "--mono": "mono",
    "font-size": 16,
    "tag-style": "pill",
    "radius": "soft",
    "heading-scale": "large",
    "line-width": "narrow",
    "line-height": "snug",
    "blockquote-style": "panel",
    "emphasis-color": "semantic",
    "checkbox-style": "round",
    "hr-style": "line"
  }
}
