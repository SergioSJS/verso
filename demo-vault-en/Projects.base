filters:
  and:
    - file.inFolder("projects")
formulas:
  orcamento_mil: "(orcamento / 1000).toFixed(1)"
  mes: 'date.toString().replace(/^(\d{4})-(\d{2})-\d{2}$/, "$2/$1")'
properties:
  formula.orcamento_mil:
    displayName: Budget (thousands)
  formula.mes:
    displayName: Month
views:
  - type: table
    name: All Projects
    order:
      - file.name
      - status
      - prioridade
      - responsavel
      - orcamento
      - formula.orcamento_mil
      - formula.mes
    sort:
      - property: date
        direction: DESC
    summaries:
      orcamento: Sum
  - type: kanban
    name: By Status
    groupBy: status
  - type: cards
    name: Cards
  - type: calendar
    name: Calendar
    startDate: date
  - type: list
    name: Project List
  - type: map
    name: Map
    order:
      - file.name
      - status
    coordinates: note.local
