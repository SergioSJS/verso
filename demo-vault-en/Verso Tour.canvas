			{"id":"d-focos-k20-t","type":"text","x":755,"y":6938.5,"width":72,"height":35,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"frameId":"g-focos","text":"menu","originalText":"menu","fontSize":28,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-focos-k20","lineHeight":1.25},
			{"id":"d-focos-w2","type":"text","x":866,"y":6940,"width":214.5,"height":37.5,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"g-focos","text":"Add to focus…","originalText":"Add to focus…","fontSize":30,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
