			{"id":"d-blocos-k30-t","type":"text","x":2405,"y":543.5,"width":54,"height":35,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"frameId":"g-blocos","text":"⌘","originalText":"⌘","fontSize":28,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-blocos-k30","lineHeight":1.25},
