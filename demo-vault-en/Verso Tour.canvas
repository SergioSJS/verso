			{"id":"d-paleta-4-t","type":"text","x":4355,"y":4431.25,"width":240,"height":37.5,"strokeColor":"#dfe8d8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"frameId":"g-ajustes","text":"Moss","originalText":"Moss","fontSize":30,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-paleta-4","lineHeight":1.25},
			{"id":"d-terminal-dica","type":"text","x":40,"y":5930,"width":1320,"height":175.5,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"g-terminal","text":"Install the verso command in Settings › Terminal and agents and search the notes from the terminal. With one click the folder goes into Claude Desktop or Claude Code: the agent reads the notes and never writes to them. Turned on in Settings › Features, a terminal of this computer opens in a tab, at the folder's root (palette › New terminal); AI tools finds Claude Code, Gemini CLI, Codex and others in your shell and starts them there.","originalText":"Install the verso command in Settings › Terminal and agents and search the notes from the terminal. With one click the folder goes into Claude Desktop or Claude Code: the agent reads the notes and never writes to them. Turned on in Settings › Features, a terminal of this computer opens in a tab, at the folder's root (palette › New terminal); AI tools finds Claude Code, Gemini CLI, Codex and others in your shell and starts them there.","fontSize":26,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-terminal",
				"type":"rectangle",
				"x":740,
				"y":5360,
				"width":620,
				"height":380,
				"strokeColor":"#212529",
