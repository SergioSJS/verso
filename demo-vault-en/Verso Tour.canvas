				"points":[
					[0,0],
					[10,90],
					[-20,200]
				],
				"startArrowhead":null,
				"endArrowhead":"arrow"
			},
			{"id":"d-ajustes-dica","type":"text","x":3340,"y":4630,"width":1320,"height":140.4,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"g-ajustes","text":"⌘, ⌘, opens Settings: theme, palette, fonts, language, the folder's folders and, in Hotkeys, each command's key — change any you like. In Appearance, the theme gallery changes the look with one click; Copy and Edit open the Theme builder, which changes the colors live, and .verso-theme themes can be imported and exported.","originalText":"⌘, ⌘, opens Settings: theme, palette, fonts, language, the folder's folders and, in Hotkeys, each command's key — change any you like. In Appearance, the theme gallery changes the look with one click; Copy and Edit open the Theme builder, which changes the colors live, and .verso-theme themes can be imported and exported.","fontSize":26,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{"id":"d-paletas","type":"text","x":4040,"y":4050,"width":299.2,"height":40,"strokeColor":"#868e96","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"g-ajustes","text":"the four palettes","originalText":"the four palettes","fontSize":32,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
