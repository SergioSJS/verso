					{"id":"d-arquivo-desafio-t","type":"text"}
				]
			},
			{"id":"d-arquivo-desafio-t","type":"text","x":3055,"y":4035,"width":550,"height":90,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-arquivo","text":"Challenge: open the Excalidraw Drawing through the ↗, click Convert to board and see the new board in Text mode.","originalText":"Challenge: open the Excalidraw Drawing through the ↗, click Convert to board and see the new board in Text mode.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-arquivo-desafio","lineHeight":1.25},
			{"id":"d-mapas-titulo","type":"text","x":40,"y":4436,"width":387.2,"height":55,"strokeColor":"#0c8599","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-mapas","text":"🗺️ Maps and pins","originalText":"🗺️ Maps and pins","fontSize":44,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-mapas-texto","type":"text","x":40,"y":4520,"width":580,"height":615.6,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-mapas","text":"A map is an image on the board that does not move by accident, with pins on top.\n• Select the image and use Use as map, in the corner tools: it locks, goes to the back and gets marked. Stop using as map is in the Outline, under Maps.\n• Drag a note from the tree onto the map, or use Pin a note here…: a pin is born that keeps its size at any zoom.\n• Click the pin to open the note; hold the pointer on it to see the note in a card. Tab walks the pins, and the Outline lists them.\n• Send to back and Bring to front exist on every card.\n• In a UniVerso, Hidden from readers hides a pin from whoever only reads; View as a reader shows how it looks.\n• A large PNG image is cut into tiles: it opens fast, even on the phone.","originalText":"A map is an image on the board that does not move by accident, with pins on top.\n• Select the image and use Use as map, in the corner tools: it locks, goes to the back and gets marked. Stop using as map is in the Outline, under Maps.\n• Drag a note from the tree onto the map, or use Pin a note here…: a pin is born that keeps its size at any zoom.\n• Click the pin to open the note; hold the pointer on it to see the note in a card. Tab walks the pins, and the Outline lists them.\n• Send to back and Bring to front exist on every card.\n• In a UniVerso, Hidden from readers hides a pin from whoever only reads; View as a reader shows how it looks.\n• A large PNG image is cut into tiles: it opens fast, even on the phone.","fontSize":24,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-mapas-desafio",
				"type":"rectangle",
				"x":40,
				"y":5100,
				"width":580,
				"height":160,
				"strokeColor":"#f08c00",
				"backgroundColor":"#ffec99",
				"fillStyle":"solid",
				"strokeWidth":1,
				"strokeStyle":"solid",
				"roughness":1,
				"opacity":100,
				"roundness":{"type":3},
				"frameId":"l-mapas",
				"boundElements":[
					{"id":"d-mapas-desafio-t","type":"text"}
				]
			},
			{"id":"d-mapas-desafio-t","type":"text","x":55,"y":5120,"width":550,"height":120,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-mapas","text":"Challenge: make the image a map, pin the note Gray Harbor on it, zoom in and out (the pin does not grow) and hold the pointer over it.","originalText":"Challenge: make the image a map, pin the note Gray Harbor on it, zoom in and out (the pin does not grow) and hold the pointer over it.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-mapas-desafio","lineHeight":1.25},
			{"id":"d-paginas-titulo","type":"text","x":1540,"y":4436,"width":266.2,"height":55,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-paginas","text":"🌐 Web pages","originalText":"🌐 Web pages","fontSize":44,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-paginas-texto","type":"text","x":1540,"y":4520,"width":580,"height":583.2,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-paginas","text":"A card can show a live web page, from a site you allowed.\n• Insert › Web page…: paste the address (https://…). The first time, Verso asks whether it may show that site, and warns first if it forbids being embedded.\n• An ordinary link becomes a page with Show page, in the corner tools; Show as link undoes it.\n• The page only receives the mouse once you enter it: click the middle of the card, or the Interact with the page button. To leave, click outside, or use the Leave button, or Esc with focus on the card's header.\n• If the site forbids being embedded, the card shows that and a link to open it in a tab.\n• The file keeps a plain JSON Canvas link card: Obsidian shows the address.","originalText":"A card can show a live web page, from a site you allowed.\n• Insert › Web page…: paste the address (https://…). The first time, Verso asks whether it may show that site, and warns first if it forbids being embedded.\n• An ordinary link becomes a page with Show page, in the corner tools; Show as link undoes it.\n• The page only receives the mouse once you enter it: click the middle of the card, or the Interact with the page button. To leave, click outside, or use the Leave button, or Esc with focus on the card's header.\n• If the site forbids being embedded, the card shows that and a link to open it in a tab.\n• The file keeps a plain JSON Canvas link card: Obsidian shows the address.","fontSize":24,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-paginas-desafio",
				"type":"rectangle",
				"x":1540,
				"y":5100,
				"width":580,
				"height":160,
				"strokeColor":"#f08c00",
				"backgroundColor":"#ffec99",
				"fillStyle":"solid",
				"strokeWidth":1,
				"strokeStyle":"solid",
				"roughness":1,
				"opacity":100,
				"roundness":{"type":3},
				"frameId":"l-paginas",
				"boundElements":[
					{"id":"d-paginas-desafio-t","type":"text"}
				]
			},
			{"id":"d-paginas-desafio-t","type":"text","x":1555,"y":5120,"width":550,"height":120,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-paginas","text":"Challenge: allow the card's site, enter the page, scroll in it and leave with the Leave button. Then switch to Show as link and back.","originalText":"Challenge: allow the card's site, enter the page, scroll in it and leave with the Leave button. Then switch to Show as link and back.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-paginas-desafio","lineHeight":1.25},
			{"id":"d-dados-titulo","type":"text","x":3040,"y":4436,"width":290.4,"height":55,"strokeColor":"#0c8599","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-dados","text":"🧮 Data files","originalText":"🧮 Data files","fontSize":44,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-dados-texto","type":"text","x":3040,"y":4520,"width":580,"height":745.2,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-dados","text":"A JSON, YAML, TOML, XML or CSV file of the folder shows its content on the card, never an empty box.\n• Drag the file from the tree onto the board, or use Note or file from the folder…: the card appears showing the text, coloured as in the editor.\n• In the header, Text | Diagram switches the view: the Diagram draws the file's boxes and lines (it needs the Data diagram feature on in Settings › Features; off, text only).\n• The diagram only receives the mouse once you enter it: click the Interact with the diagram button. Then move, fold and zoom in it; Esc, or the Leave button, give the board back.\n• Open takes the file to its tab, in the view the card shows. The card follows the file when it changes, and only reads: it never writes it.\n• A large file shows only its first 64 KB, with an ellipsis. The card keeps the view under the canvas's verso key: Obsidian ignores it.","originalText":"A JSON, YAML, TOML, XML or CSV file of the folder shows its content on the card, never an empty box.\n• Drag the file from the tree onto the board, or use Note or file from the folder…: the card appears showing the text, coloured as in the editor.\n• In the header, Text | Diagram switches the view: the Diagram draws the file's boxes and lines (it needs the Data diagram feature on in Settings › Features; off, text only).\n• The diagram only receives the mouse once you enter it: click the Interact with the diagram button. Then move, fold and zoom in it; Esc, or the Leave button, give the board back.\n• Open takes the file to its tab, in the view the card shows. The card follows the file when it changes, and only reads: it never writes it.\n• A large file shows only its first 64 KB, with an ellipsis. The card keeps the view under the canvas's verso key: Obsidian ignores it.","fontSize":24,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-dados-desafio",
				"type":"rectangle",
				"x":3040,
				"y":5100,
				"width":580,
				"height":160,
				"strokeColor":"#f08c00",
				"backgroundColor":"#ffec99",
				"fillStyle":"solid",
				"strokeWidth":1,
				"strokeStyle":"solid",
				"roughness":1,
				"opacity":100,
				"roundness":{"type":3},
				"frameId":"l-dados",
				"boundElements":[
					{"id":"d-dados-desafio-t","type":"text"}
				]
			},
			{"id":"d-dados-desafio-t","type":"text","x":3055,"y":5120,"width":550,"height":120,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-dados","text":"Challenge: switch the card to Diagram, enter it, drag the background to move the diagram and leave with Esc. Then go back to Text.","originalText":"Challenge: switch the card to Diagram, enter it, drag the background to move the diagram and leave with Esc. Then go back to Text.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-dados-desafio","lineHeight":1.25},
			{"id":"d-som-titulo","type":"text","x":40,"y":5536,"width":411.4,"height":55,"strokeColor":"#0c8599","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-som","text":"🎵 Sound on a card","originalText":"🎵 Sound on a card","fontSize":44,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-som-texto","type":"text","x":40,"y":5620,"width":580,"height":453.6,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-som","text":"A sound file of the folder — MP3, M4A, AAC, OGG, WAV or FLAC — is a card with a player.\n• Drag the file from the tree onto the board, or use Note or file of the folder…; a sound file dragged from the computer goes into the folder and becomes the card.\n• Play, Pause, the bar with the time, Mute and the Volume work right on the card, without entering it. It plays for you only.\n• The card moves by its header or its edges, and resizes like the others.\n• At a table, the game master has Play for the table: the track goes to the Music tab and everyone hears it (note 27).","originalText":"A sound file of the folder — MP3, M4A, AAC, OGG, WAV or FLAC — is a card with a player.\n• Drag the file from the tree onto the board, or use Note or file of the folder…; a sound file dragged from the computer goes into the folder and becomes the card.\n• Play, Pause, the bar with the time, Mute and the Volume work right on the card, without entering it. It plays for you only.\n• The card moves by its header or its edges, and resizes like the others.\n• At a table, the game master has Play for the table: the track goes to the Music tab and everyone hears it (note 27).","fontSize":24,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-som-desafio",
				"type":"rectangle",
				"x":40,
				"y":6200,
				"width":580,
				"height":160,
				"strokeColor":"#f08c00",
				"backgroundColor":"#ffec99",
				"fillStyle":"solid",
				"strokeWidth":1,
				"strokeStyle":"solid",
				"roughness":1,
				"opacity":100,
				"roundness":{"type":3},
				"frameId":"l-som",
				"boundElements":[
					{"id":"d-som-desafio-t","type":"text"}
				]
			},
			{"id":"d-som-desafio-t","type":"text","x":55,"y":6235,"width":550,"height":90,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-som","text":"Challenge: play the track, drag the bar to the middle and mute it. Then make the card bigger by its corner.","originalText":"Challenge: play the track, drag the bar to the middle and mute it. Then make the card bigger by its corner.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-som-desafio","lineHeight":1.25},
			{"id":"d-titulo","type":"text","x":0,"y":-560,"width":924,"height":150,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"text":"Board Training","originalText":"Board Training","fontSize":120,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-sub","type":"text","x":6,"y":-390,"width":1298,"height":50,"strokeColor":"#868e96","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"text":"Excalidraw lessons: read on the left, practice on the right","originalText":"Excalidraw lessons: read on the left, practice on the right","fontSize":40,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
