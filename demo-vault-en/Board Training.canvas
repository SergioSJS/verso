				]
			},
			{"id":"d-selecionar-desafio-t","type":"text","x":1555,"y":735,"width":550,"height":90,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-selecionar","text":"Challenge: align the three squares by the top and leave the same space between them.","originalText":"Challenge: align the three squares by the top and leave the same space between them.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-selecionar-desafio","lineHeight":1.25},
			{"id":"d-desenhar-titulo","type":"text","x":3040,"y":36,"width":169.4,"height":55,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-desenhar","text":"✏️ Draw","originalText":"✏️ Draw","fontSize":44,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-desenhar-texto","type":"text","x":3040,"y":120,"width":580,"height":324,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-desenhar","text":"Each tool on the top bar has its key: 1 selection, 2 rectangle, 3 diamond, 4 ellipse, 5 arrow, 6 line, 7 pencil, 8 text, 0 eraser. H is the hand.\n• ⇧ while drawing makes perfect squares and circles.\n• The lock (Q) keeps the tool after drawing.\n• Double-click on empty space puts a text card (Markdown); Excalidraw's loose text is the T key.","originalText":"Each tool on the top bar has its key: 1 selection, 2 rectangle, 3 diamond, 4 ellipse, 5 arrow, 6 line, 7 pencil, 8 text, 0 eraser. H is the hand.\n• ⇧ while drawing makes perfect squares and circles.\n• The lock (Q) keeps the tool after drawing.\n• Double-click on empty space puts a text card (Markdown); Excalidraw's loose text is the T key.","fontSize":24,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-desenhar-desafio",
				"type":"rectangle",
				"x":3040,
				"y":700,
				"width":580,
