				"frameId":"l-andar",
				"boundElements":[
					{"id":"d-andar-desafio-t","type":"text"}
				]
			},
			{"id":"d-andar-desafio-t","type":"text","x":55,"y":735,"width":550,"height":90,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-andar","text":"Challenge: there is a ⭐ hidden on this board. Press ⇧1, find it, get close and come back through the Outline.","originalText":"Challenge: there is a ⭐ hidden on this board. Press ⇧1, find it, get close and come back through the Outline.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-andar-desafio","lineHeight":1.25},
			{"id":"d-selecionar-titulo","type":"text","x":1540,"y":36,"width":411.4,"height":55,"strokeColor":"#6741d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-selecionar","text":"👆 Select and move","originalText":"👆 Select and move","fontSize":44,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-selecionar-texto","type":"text","x":1540,"y":120,"width":580,"height":259.2,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-selecionar","text":"• Click selects; ⇧ + click adds one more.\n• Drag on empty space to lasso several; ⌘A selects all.\n• Drag to move; the arrow keys nudge (with ⇧, farther).\n• ⌥ + drag or ⌘D duplicates. Delete removes.\n• With two or more selected, the left panel shows Align.","originalText":"• Click selects; ⇧ + click adds one more.\n• Drag on empty space to lasso several; ⌘A selects all.\n• Drag to move; the arrow keys nudge (with ⇧, farther).\n• ⌥ + drag or ⌘D duplicates. Delete removes.\n• With two or more selected, the left panel shows Align.","fontSize":24,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-selecionar-desafio",
				"type":"rectangle",
				"x":1540,
				"y":700,
				"width":580,
				"height":160,
				"strokeColor":"#f08c00",
