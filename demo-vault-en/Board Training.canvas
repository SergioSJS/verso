				]
			},
			{"id":"d-cartoes-desafio-t","type":"text","x":1555,"y":2935,"width":550,"height":90,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-cartoes","text":"Challenge: put the note “00 - Welcome to Verso” in the dashed space, paint the card and edit the text card.","originalText":"Challenge: put the note “00 - Welcome to Verso” in the dashed space, paint the card and edit the text card.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-cartoes-desafio","lineHeight":1.25},
			{"id":"d-truques-titulo","type":"text","x":3040,"y":2236,"width":193.6,"height":55,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-truques","text":"✨ Tricks","originalText":"✨ Tricks","fontSize":44,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-truques-texto","type":"text","x":3040,"y":2320,"width":580,"height":324,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-truques","text":"• ⌘⇧L locks what is selected; a right click on it unlocks.\n• ⌘' turns the grid on.\n• K is the laser pointer, for presenting.\n• More tools → Mermaid to Excalidraw turns a flowchart into shapes.\n• ⌘⇧E exports the board, or the selection, as PNG or SVG.\n• ⌘F searches the board. ? shows all the shortcuts.","originalText":"• ⌘⇧L locks what is selected; a right click on it unlocks.\n• ⌘' turns the grid on.\n• K is the laser pointer, for presenting.\n• More tools → Mermaid to Excalidraw turns a flowchart into shapes.\n• ⌘⇧E exports the board, or the selection, as PNG or SVG.\n• ⌘F searches the board. ? shows all the shortcuts.","fontSize":24,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-truques-desafio",
				"type":"rectangle",
				"x":3040,
				"y":2900,
