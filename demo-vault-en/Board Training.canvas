					{"id":"d-estilo-desafio-t","type":"text"}
				]
			},
			{"id":"d-estilo-desafio-t","type":"text","x":55,"y":1850,"width":550,"height":60,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-estilo","text":"Challenge: copy the style of the red balloon and paste it on the other two.","originalText":"Challenge: copy the style of the red balloon and paste it on the other two.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-estilo-desafio","lineHeight":1.25},
			{"id":"d-ligar-titulo","type":"text","x":1540,"y":1136,"width":726,"height":55,"strokeColor":"#0c8599","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-ligar","text":"🔗 Connect one thing to another","originalText":"🔗 Connect one thing to another","fontSize":44,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-ligar-texto","type":"text","x":1540,"y":1220,"width":580,"height":486,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-ligar","text":"1. Grab the Arrow (A or 5).\n2. Start on top of a card and release on top of another: the border lights up when the arrow sticks, and each end aims at the point where you started and released.\n3. Move a card: the arrow goes along, aiming at the same point.\n4. Double-click the arrow to write a label.\n5. In the left column, Arrow type: sharp, round, elbow, and the Arrowheads.\n6. A free arrow, attached to nothing: hold ⌘ while drawing — or, on touch, Insert › Loose arrows (on a phone, ⋯ › Board › Loose arrows).\nBetween two cards, the arrow is a canvas connection, which Obsidian shows too.","originalText":"1. Grab the Arrow (A or 5).\n2. Start on top of a card and release on top of another: the border lights up when the arrow sticks, and each end aims at the point where you started and released.\n3. Move a card: the arrow goes along, aiming at the same point.\n4. Double-click the arrow to write a label.\n5. In the left column, Arrow type: sharp, round, elbow, and the Arrowheads.\n6. A free arrow, attached to nothing: hold ⌘ while drawing — or, on touch, Insert › Loose arrows (on a phone, ⋯ › Board › Loose arrows).\nBetween two cards, the arrow is a canvas connection, which Obsidian shows too.","fontSize":24,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-ligar-desafio",
				"type":"rectangle",
				"x":1540,
				"y":1800,
				"width":580,
				"height":160,
