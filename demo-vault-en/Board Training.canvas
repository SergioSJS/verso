			},
			{"id":"d-buscar-desafio-t","type":"text","x":1555,"y":4035,"width":550,"height":90,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-buscar","text":"Challenge: find the treasure hidden on this board with ⌘F. Then select this lesson and export only it as a PNG.","originalText":"Challenge: find the treasure hidden on this board with ⌘F. Then select this lesson and export only it as a PNG.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-buscar-desafio","lineHeight":1.25},
			{"id":"d-arquivo-titulo","type":"text","x":3040,"y":3336,"width":605,"height":55,"strokeColor":"#e67700","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-arquivo","text":"🗂️ The board and the file","originalText":"🗂️ The board and the file","fontSize":44,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-arquivo-texto","type":"text","x":3040,"y":3420,"width":580,"height":421.2,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-arquivo","text":"• • New board: in the palette, or in the New menu of the + button in the left strip.\n• Text, in the tab's corner, shows the .canvas as JSON: the same file Obsidian opens.\n• In the board's ☰ menu, Canvas background changes the background color — and it stays in the file.\n• Settings › Board: open as a board or as text, show everything or where you left off, the stroke, the font, the grid and the folder of new boards.\n• A drawing from the Excalidraw plugin becomes a board with Convert to board.","originalText":"• • New board: in the palette, or in the New menu of the + button in the left strip.\n• Text, in the tab's corner, shows the .canvas as JSON: the same file Obsidian opens.\n• In the board's ☰ menu, Canvas background changes the background color — and it stays in the file.\n• Settings › Board: open as a board or as text, show everything or where you left off, the stroke, the font, the grid and the folder of new boards.\n• A drawing from the Excalidraw plugin becomes a board with Convert to board.","fontSize":24,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-arquivo-desafio",
				"type":"rectangle",
				"x":3040,
				"y":4000,
				"width":580,
				"height":160,
				"strokeColor":"#f08c00",
				"backgroundColor":"#ffec99",
				"fillStyle":"solid",
				"strokeWidth":1,
				"strokeStyle":"solid",
				"roughness":1,
				"opacity":100,
				"roundness":{"type":3},
				"frameId":"l-arquivo",
