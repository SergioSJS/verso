			{"id":"d-paleta-4-t","type":"text","x":1055,"y":4431.25,"width":240,"height":37.5,"strokeColor":"#dfe8d8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"frameId":"g-ajustes","text":"Musgo","originalText":"Musgo","fontSize":30,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-paleta-4","lineHeight":1.25},
			{"id":"d-terminal-dica","type":"text","x":1690,"y":4630,"width":1320,"height":105.3,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"g-terminal","text":"Instale o comando verso em Ajustes › Terminal e agentes e busque nas notas pelo terminal. Com um clique o cofre entra no Claude Desktop ou no Claude Code: o agente lê as notas e nunca escreve nelas.","originalText":"Instale o comando verso em Ajustes › Terminal e agentes e busque nas notas pelo terminal. Com um clique o cofre entra no Claude Desktop ou no Claude Code: o agente lê as notas e nunca escreve nelas.","fontSize":26,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-terminal",
				"type":"rectangle",
				"x":2390,
				"y":4060,
