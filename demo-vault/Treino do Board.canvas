				]
			},
			{"id":"d-andar-desafio-t","type":"text","x":55,"y":735,"width":550,"height":90,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-andar","text":"Desafio: há uma ⭐ escondida neste board. Aperte ⇧1, ache, chegue perto e volte pelo Sumário.","originalText":"Desafio: há uma ⭐ escondida neste board. Aperte ⇧1, ache, chegue perto e volte pelo Sumário.","fontSize":24,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"d-andar-desafio","lineHeight":1.25},
			{"id":"d-selecionar-titulo","type":"text","x":1540,"y":36,"width":484,"height":55,"strokeColor":"#6741d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-selecionar","text":"👆 Selecionar e mover","originalText":"👆 Selecionar e mover","fontSize":44,"fontFamily":5,"textAlign":"left","verticalAlign":"top","lineHeight":1.25},
			{"id":"d-selecionar-texto","type":"text","x":1540,"y":120,"width":580,"height":259.2,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"frameId":"l-selecionar","text":"• Clique seleciona; ⇧ + clique soma mais um.\n• Arraste no vazio para laçar vários; ⌘A seleciona tudo.\n• Arraste para mover; as setas do teclado empurram (com ⇧, mais longe).\n• ⌥ + arrastar ou ⌘D duplica. Delete apaga.\n• Com dois ou mais selecionados, o painel da esquerda mostra Alinhamento.","originalText":"• Clique seleciona; ⇧ + clique soma mais um.\n• Arraste no vazio para laçar vários; ⌘A seleciona tudo.\n• Arraste para mover; as setas do teclado empurram (com ⇧, mais longe).\n• ⌥ + arrastar ou ⌘D duplica. Delete apaga.\n• Com dois ou mais selecionados, o painel da esquerda mostra Alinhamento.","fontSize":24,"fontFamily":6,"textAlign":"left","verticalAlign":"top","lineHeight":1.35,"autoResize":false},
			{
				"id":"d-selecionar-desafio",
				"type":"rectangle",
