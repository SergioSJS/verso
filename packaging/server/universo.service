# The Verso server as a systemd service (ADR 0075 item 2): installed by the
# universo .deb and .rpm at /usr/lib/systemd/system/universo.service, or
# copied there from the archive. Its settings are in /etc/universo/universo.env;
# docs/reference/server-install.md explains each one.
#
# Not started on install: edit /etc/universo/universo.env first, then
#   sudo systemctl enable --now universo
#
# Changes of your own go in a drop-in (`sudo systemctl edit universo`), which
# an upgrade does not overwrite — for example a folders directory outside
# /var/lib/universo:
#   [Service]
#   ReadWritePaths=/srv/notes
# (and, on a network mount, RequiresMountsFor=/srv/notes in [Unit]).

[Unit]
Description=UniVerso, the Verso server
Documentation=https://github.com/SergioSJS/verso/blob/main/docs/reference/server-install.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=universo
Group=universo
EnvironmentFile=/etc/universo/universo.env
ExecStart=/usr/bin/universo --web
# SIGTERM, systemd's default, stops the server cleanly.
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
# ADR 0075, 2026-10-31 (B9): out of memory kills the server, which restarts,
# and not the machine — three quarters of it, as the container's 768m on a
# 1 GB server. A drop-in changes it (MemoryMax=2G, or infinity for none).
MemoryMax=75%

# Hardening. The server writes only under /var/lib/universo (the two
# directories of universo.env); everything else is read-only to it.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/universo
# A folders directory under /home needs ProtectHome=no or a ReadWritePaths
# of its own in a drop-in (above): read-only here.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# ADR 0083 item 11: other processes of the host unseen in /proc, and
# /proc reduced to processes; system calls of an ordinary service only,
# none of the privileged or resource-changing sets; what the server makes
# (a folder, the database) closed to others whatever the folders root
# gives them.
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027
# No capabilities. To listen on a port under 1024 (443 with
# VERSO_TLS_CERT_FILE), a drop-in adds both:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
