# The Verso server as a systemd service (ADR 0075 item 2): installed by the
# verso-server .deb and .rpm at /usr/lib/systemd/system/verso.service, or
# copied there from the archive. Its settings are in /etc/verso/verso.env;
# docs/reference/server-install.md explains each one.
#
# Not started on install: edit /etc/verso/verso.env first, then
#   sudo systemctl enable --now verso
#
# Changes of your own go in a drop-in (`sudo systemctl edit verso`), which
# an upgrade does not overwrite — for example a folders directory outside
# /var/lib/verso:
#   [Service]
#   ReadWritePaths=/srv/notes
# (and, on a network mount, RequiresMountsFor=/srv/notes in [Unit]).

[Unit]
Description=Verso server (verso serve)
Documentation=https://github.com/SergioSJS/verso/blob/main/docs/reference/server-install.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=verso
Group=verso
EnvironmentFile=/etc/verso/verso.env
ExecStart=/usr/bin/verso serve --web
# SIGTERM, systemd's default, stops the server cleanly.
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# Hardening. The server writes only under /var/lib/verso (the two
# directories of verso.env); everything else is read-only to it.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/verso
# A folders directory under /home needs ProtectHome=no or a ReadWritePaths
# of its own in a drop-in (above): read-only here.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No capabilities. To listen on a port under 1024 (443 with
# VERSO_TLS_CERT_FILE), a drop-in adds both:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
