# Settings of the Verso server (`verso serve`), read by the systemd unit
# (/usr/lib/systemd/system/universo.service, EnvironmentFile=). An upgrade of
# the package keeps your edits. After a change:
#   sudo systemctl restart universo
#
# Every variable may instead be given as NAME_FILE, the path of a file
# holding the value (giving both is an error). A line left empty, or
# commented out, means "not set". Explained in full in
# docs/reference/server-install.md (ADR 0074, ADR 0075).
#
# This file can hold the first admin's password: it is readable by root and
# the universo group only. Keep it so.

# Where the server listens. Loopback by default: put a reverse proxy or
# `tailscale serve` in front. Listening beyond loopback (0.0.0.0:7340)
# requires VERSO_PUBLIC_URL, or the server refuses to start.
VERSO_LISTEN=127.0.0.1:7340

# The address people type in the browser, with https, for example
# https://universo.your-tailnet.ts.net or https://notes.example.com. Needed
# for sign-in from anywhere but this machine.
VERSO_PUBLIC_URL=

# The accounts, sessions, audit log and indexes (SQLite). A LOCAL disk:
# SQLite can be corrupted on NFS, SMB/CIFS or sshfs. Not a cache: back it up.
VERSO_DATA_DIR=/var/lib/universo/data

# The root under which the folders of notes live. May be a NAS. A path
# outside /var/lib/universo also needs ReadWritePaths in a drop-in of the unit
# (`sudo systemctl edit universo`), and must be writable by the universo user.
VERSO_FOLDERS_DIR=/var/lib/universo/folders

# The window's files, installed by the package.
VERSO_UI_DIR=/usr/share/universo/ui

# The first admin, created on the FIRST start only, when no account exists;
# ignored afterwards (changing them never resets a password). Left empty,
# the log (journalctl -u universo) prints a setup link valid for one hour.
# The password: 12 characters at least, not one of the commonest passwords
# attackers try first, not the e-mail. Remove it from this file once the
# admin exists. A lost admin password prints a reset link with
#   sudo -u universo -H sh -c 'set -a; . /etc/universo/universo.env; exec universo admin reset <e-mail>'
VERSO_ADMIN_EMAIL=
VERSO_ADMIN_PASSWORD=
# Or the password from a file instead (only one of the two):
#VERSO_ADMIN_PASSWORD_FILE=/etc/universo/admin-password

# The reverse proxies in front, whose forwarded headers are believed
# (X-Forwarded-For and X-Forwarded-Proto): one address, or a list of
# addresses and CIDRs separated by commas, IPv4 and IPv6, such as
#   VERSO_TRUSTED_PROXY=127.0.0.1, 10.0.0.0/8, 2001:db8::/32
# Only with a proxy, and only the proxies' own addresses: a proxy left out
# makes every visitor one address, and every per-address limit then keys
# it. Behind Cloudflare: the installation guide, section 8.
VERSO_TRUSTED_PROXY=

# TLS served by Verso itself, from a certificate and key in PEM. Both or
# neither. Readable by the universo user. Without them, put TLS in front.
VERSO_TLS_CERT_FILE=
VERSO_TLS_KEY_FILE=

# The server asks the project's release feed whether a new version exists
# and says so on the admin page; it never updates itself. `off` stops the
# check.
#VERSO_UPDATE_CHECK=off

# A token that reads the project's releases, for the check while the
# repository is private (any value may also be given as NAME_FILE).
#VERSO_UPDATE_TOKEN=

# The host's mail server, for sign-in links, "forgot the password" and
# invitations by e-mail (ADR 0074): smtps://user:password@host:465
#VERSO_SMTP_URL=
#VERSO_MAIL_FROM=Verso <verso@notes.example.org>
